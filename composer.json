{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "maristas/sigem-api-client",
    "description": "Cliente HTTP con cache para consumir la API SSO de SIGEM desde sistemas perifericos.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Maristas\\SigemApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Maristas\\SigemApi\\SigemServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
